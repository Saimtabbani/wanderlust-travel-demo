# Required for non-development deployments. Generate a long random value.
WANDERLUST_SESSION_SECRET=

# Required before accepting real accounts or endorsements. Use a managed database
# URL supported by SQLAlchemy and keep it in the deployment provider's secret store.
# SQLite remains the local demo default and is not durable on Vercel functions.
WANDERLUST_DATABASE_URL=

# One-time GeoNames catalogue import key. Keep it in the deployment secret store.
WANDERLUST_CATALOG_IMPORT_KEY=
